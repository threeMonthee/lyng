# 复制成 .env（已 gitignore）并填写。密钥只放这里或进程环境，不进仓库。

# 真实模型（OpenRouter）。--fake 模式不需要
OPENROUTER_API_KEY=

# 可选
# LYNG_MODEL_BACKEND=openrouter     # 或 fake：确定性替身，不发网络请求
# LYNG_MODEL=deepseek/deepseek-v4.1-flash   # 所有角色的默认模型，可写成 模型ID@推理设置（off / low / medium / high）
# LYNG_MODEL_CHARACTER=             # 单独指定：人物
# LYNG_MODEL_NARRATOR=              # 叙事者的开场与收尾
# LYNG_MODEL_NARRATOR_ROUND=        # 叙事者逐轮决定（默认关推理）
# LYNG_MODEL_CREATION=              # 创作
# LYNG_MODEL_RECALL=                # 回想
# LYNG_PROVIDER=Parasail            # OpenRouter 首选服务商，故障时回退；空=不指定
# LYNG_BUDGET_USD=1                 # 累计费用硬上限（美元），达到就停
# LYNG_PORT=8080
# LYNG_DB=../data/lyng.db           # SQLite 文件，相对 server/ 目录
