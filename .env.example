# 复制成 .env（已 gitignore）并填写。密钥与口令只放这里或进程环境，不进仓库。

# 登录用：单个本地账号
LYNG_USER=me
LYNG_PASSWORD=

# 真实模型（OpenRouter）。fake 模式不需要
OPENROUTER_API_KEY=

# 可选
# LYNG_MODEL_BACKEND=openrouter   # 或 fake：确定性替身，不发网络请求
# LYNG_MODEL=deepseek/deepseek-v4.1-flash
# LYNG_REASONING=                  # 空=模型默认（开推理）；off / low / medium / high
# LYNG_PROVIDER=DeepSeek           # 首选服务商，故障时回退；空=不指定
# LYNG_BUDGET_USD=1                # 累计费用硬上限（美元），达到就停
# LYNG_PORT=8080
# LYNG_DB_URL=jdbc:postgresql://localhost:5432/lyng
