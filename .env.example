# 复制成仓库根的 .env 再填写（.env 已 gitignore，服务启动时自动读取）。
# 真实的 key 只放在 .env 里，不要写进任何会提交的文件。

# 模型：OpenRouter（https://openrouter.ai/keys）
OPENROUTER_API_KEY=
# 记忆向量：阿里云百炼
DASHSCOPE_API_KEY=

# 以下都可以不填，括号里是默认值
# LYNG_MODEL=deepseek/deepseek-v4.1-flash      # 所有用途默认的模型
# LYNG_PROVIDER=Parasail                       # 首选服务商，允许回退
# LYNG_MODEL_CHARACTER=                        # 按用途单独指定：模型ID@推理（off/low/medium/high），只写 @off 表示默认模型关推理
# LYNG_MODEL_NARRATOR=
# LYNG_MODEL_NARRATOR_ROUND=@off
# LYNG_MODEL_CHECK=@off
# LYNG_MODEL_CONSOLIDATE=
# LYNG_MODEL_CREATE=
# LYNG_BUDGET_USD=                             # 累计费用上限（设置页里改的优先）

# LYNG_DB_URL=jdbc:postgresql://localhost:5432/lyng
# LYNG_DB_USER=lyng
# LYNG_DB_PASSWORD=lyng
# LYNG_PORT=8080
# LYNG_HOST=127.0.0.1                          # 想在同一 Wi-Fi 的手机上打开，改成 0.0.0.0
# LYNG_SEED=true                               # 空库时放入诛仙世界（陆雪琪、张小凡、碧瑶）

# 替身：不调用任何服务（scripts/start.sh --fake 会设置这两项）
# LYNG_MODEL_BACKEND=fake
# LYNG_EMBEDDING_BACKEND=fake
